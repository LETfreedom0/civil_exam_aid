.card.data-v-4d144a3a {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #f0f0f0;
  position: relative;
}
.card.data-v-4d144a3a:active {
  background-color: #fafafa;
}
.header.data-v-4d144a3a {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.header .title.data-v-4d144a3a {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.header .quota.data-v-4d144a3a {
  font-size: 28rpx;
  color: #007aff;
  font-weight: bold;
  background-color: rgba(0, 122, 255, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.sub-header.data-v-4d144a3a {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.sub-header .unit.data-v-4d144a3a, .sub-header .region.data-v-4d144a3a {
  font-size: 26rpx;
